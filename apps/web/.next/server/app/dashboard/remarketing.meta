{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/remarketing/layout,_N_T_/dashboard/remarketing/page,_N_T_/dashboard/remarketing"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/remarketing/__PAGE__",
    "/dashboard/remarketing",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}